# Build-time Supabase sync (scripts/fetch-events.ts).
# These values are server-side only — NEVER prefix them with VITE_, otherwise
# the secret key would be bundled into the frontend.
SUPABASE_URL=https://xyzcompany.supabase.co
# Base project URL only — no /rest/v1 suffix (the script appends it).
SUPABASE_SECRET_KEY=sb_secret_...

# Public anon key sent by the event registration form (safe to expose —
# the Edge Function enforces all rules server-side). Optional: the function
# is deployed with verify_jwt=false, so registrations also work without it —
# but set it in production (and in Vercel env vars) for gateway metering.
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Optional overrides (defaults shown):
# SUPABASE_EVENTS_TABLE=events
# SUPABASE_EVENTS_FILTER=enabled=eq.true
# SUPABASE_EVENTS_ORDER=time.asc.nullslast
# SUPABASE_STORAGE_BUCKET=event-assets
# EVENTS_JSON_OUT=public/events.json
# EVENTS_ASSETS_DIR=public/events
# Local Edge Function dev URL:
# VITE_REGISTER_ENDPOINT=http://127.0.0.1:54321/functions/v1/register-event
